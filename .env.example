# Variables compartidas por docker compose (copiar a .env y completar)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=centinela_db

JWT_SECRET=super-secret-key

# --- SMTP (ms-notificaciones) — obligatorio ---
#
# Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=cuenta@gmail.com  SMTP_PASS=App Password (16 chars)
#   MAIL_FROM debe usar la misma cuenta (o alias configurado en Gmail)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Centinela <tu_cuenta@gmail.com>
PUBLIC_WEB_URL=http://192.168.1.12:3001
# IP de tu PC en la red Wi‑Fi (ipconfig). El celular debe estar en la misma red.
PUBLIC_API_URL=http://192.168.1.12:3000
APP_RESET_URL=centinela://reset-password
ANDROID_APP_PACKAGE=com.example.centinela_milagro
DASHBOARD_URL=http://localhost:3001

# Orígenes CORS del gateway (HTTP + WebSocket). Incluye la URL/IP desde la que abres webcentinela en el celular.
# Wi‑Fi: http://192.168.1.2:3001,http://192.168.1.2:3000
# Túnel VS Code: pega también la URL pública del puerto 3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Cloudinary (fotos reportes + evidencia policial) ---
# Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Estructura en Cloudinary: centinela/policial/YYYY-MM-DD/... | centinela/ciudadano/YYYY-MM-DD/...
CLOUDINARY_FOLDER=centinela

# --- ms-core: alertas audio IA (multi-nodo) ---
# true  = 1 nodo basta (pruebas con celular/nodo único)
# false = exige 2º nodo en la misma zona en ~30 s (producción / demo formal)
ALERT_SINGLE_NODE_BYPASS=true
ALERT_DEDUP_WINDOW_SEC=60

# Opcionales
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_GROUP_ID=
TELEGRAM_CITIZEN_CHANNEL_ID=
TELEGRAM_CHAT_ID=
