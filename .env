# ==========================================
# Centinela — variables para Docker Compose
# ==========================================

# --- Base de datos (PostgreSQL + PostGIS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=centinela_db

# --- Seguridad (JWT en c-gateway y ms-auth) ---
JWT_SECRET=super-secret-key

# --- SMTP Gmail (ms-notificaciones) ---
# 1) https://myaccount.google.com/security → Verificación en 2 pasos ON
# 2) https://myaccount.google.com/apppasswords → App "Correo" → copiar 16 chars
# 3) SMTP_PASS = App Password SIN espacios (NO uses tu contraseña normal de Gmail)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=er9335037@gmail.com
SMTP_PASS=tunsblfrqmiqsent
MAIL_FROM=Centinela <er9335037@gmail.com>

# Enlace web del panel (solo si tienes frontend web desplegado; NO uses localhost en móvil)
PUBLIC_WEB_URL=http://192.168.1.12:3001
# Deep link que abre la app móvil desde el correo
APP_RESET_URL=centinela://reset-password
ANDROID_APP_PACKAGE=com.example.centinela_milagroDASHBOARD_URL=http://localhost:3001

# --- Cloudinary (fotos de reportes y evidencia) — opcional por ahora ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=centinela

# --- Push / alertas — opcional por ahora ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
